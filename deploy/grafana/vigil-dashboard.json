{
  "title": "Vigil",
  "uid": "llcforge-vigil",
  "tags": [
    "llcforge",
    "vigil"
  ],
  "description": "Real-time BGP origin hijack detection over public route collector feeds",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "utc",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {}
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "label": "Instance",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "query": {
          "query": "label_values(llcforge_beacon_received_total{tool=\"vigil\"}, instance)",
          "refId": "instance"
        },
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Vigil on GitHub",
      "type": "link",
      "url": "https://github.com/LLCForge/Vigil"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Process",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Up",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(up{job=\"vigil\",instance=~\"$instance\"})"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Alert queue depth",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(llcforge_beacon_queue_depth{tool=\"vigil\",instance=~\"$instance\"})"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Alerts (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(llcforge_beacon_received_total{tool=\"vigil\",instance=~\"$instance\"}[24h]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Dropped (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(llcforge_beacon_dropped_total{tool=\"vigil\",instance=~\"$instance\"}[24h]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Alert pipeline",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Intake (per minute)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(llcforge_beacon_received_total{tool=\"vigil\",instance=~\"$instance\"}[5m])) * 60",
          "legendFormat": "received"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(llcforge_beacon_deduplicated_total{tool=\"vigil\",instance=~\"$instance\"}[5m])) * 60",
          "legendFormat": "deduplicated"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(llcforge_beacon_silenced_total{tool=\"vigil\",instance=~\"$instance\"}[5m])) * 60",
          "legendFormat": "silenced"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(llcforge_beacon_dropped_total{tool=\"vigil\",instance=~\"$instance\"}[5m])) * 60",
          "legendFormat": "dropped"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(llcforge_beacon_invalid_total{tool=\"vigil\",instance=~\"$instance\"}[5m])) * 60",
          "legendFormat": "invalid"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Queue depth",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (llcforge_beacon_queue_depth{tool=\"vigil\",instance=~\"$instance\"})",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Sinks",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Delivered per sink (per minute)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (sink, type) (rate(llcforge_beacon_sink_sent_total{tool=\"vigil\",instance=~\"$instance\"}[5m])) * 60",
          "legendFormat": "{{sink}} ({{type}})"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Failures per sink (per minute)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (sink, type) (rate(llcforge_beacon_sink_failed_total{tool=\"vigil\",instance=~\"$instance\"}[5m])) * 60",
          "legendFormat": "{{sink}} ({{type}})"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Pending per sink",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (sink) (llcforge_beacon_sink_queued{tool=\"vigil\",instance=~\"$instance\"})",
          "legendFormat": "{{sink}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Retries / rate-limit waits (per minute)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (sink) (rate(llcforge_beacon_sink_retries_total{tool=\"vigil\",instance=~\"$instance\"}[5m])) * 60",
          "legendFormat": "retries {{sink}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (sink) (rate(llcforge_beacon_sink_rate_limited_total{tool=\"vigil\",instance=~\"$instance\"}[5m])) * 60",
          "legendFormat": "rate-limited {{sink}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "row",
      "title": "Vigil",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Feed messages (per second)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(vigil_ris_messages_total[5m])",
          "legendFormat": "RIS Live",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "rate(vigil_kafka_messages_total[5m])",
          "legendFormat": "RouteViews Kafka",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "C",
          "expr": "rate(vigil_ris_malformed_total[5m]) + rate(vigil_kafka_malformed_total[5m])",
          "legendFormat": "malformed",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Feed health",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vigil_ris_connected",
          "legendFormat": "RIS Live connected",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "vigil_kafka_partitions",
          "legendFormat": "Kafka partitions",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "C",
          "expr": "vigil_ris_lag_seconds",
          "legendFormat": "RIS lag (s)",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Route alerts and incidents",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(vigil_alerts_total[1h])",
          "legendFormat": "alerts / h",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "vigil_open_incidents",
          "legendFormat": "open incidents",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "C",
          "expr": "increase(vigil_alerts_suppressed_total[1h])",
          "legendFormat": "suppressed / h",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Prefix visibility (share of RIS peers)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vigil_visibility_ratio",
          "legendFormat": "{{prefix}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Watch list and MRT",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vigil_watched_prefixes",
          "legendFormat": "watched prefixes",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "increase(vigil_mrt_files_total[1h])",
          "legendFormat": "MRT files / h",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "C",
          "expr": "increase(vigil_mrt_failures_total[1h])",
          "legendFormat": "MRT failures / h",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Enrichment failures and dropped sightings",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(vigil_enrich_failures_total[1h])",
          "legendFormat": "enrichment failures / h",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "increase(vigil_sightings_dropped_total[1h])",
          "legendFormat": "dropped sightings / h",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
